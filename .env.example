# Kopieren nach .env.local und ausfüllen. Niemals echte Werte committen.

# Neon PostgreSQL (nur serverseitig)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Zufälliger Geheimwert (mind. 32 Zeichen), z. B. `openssl rand -base64 32`.
# Signiert das anonyme Besucher-Cookie und salzt IP-Hashes fürs Rate-Limiting. In Produktion Pflicht.
VISITOR_COOKIE_SECRET=

# Cloudflare R2 (S3-kompatibel)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Öffentliche Basis-URL des Buckets (r2.dev-URL oder eigene Domain), ohne abschließenden Slash
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
